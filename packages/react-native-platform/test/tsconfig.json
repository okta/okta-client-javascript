{
  "extends": "@repo/typescript-config/jest.json",
  "compilerOptions": {
    "paths": {
      "src/*": ["../src/*"]
    },
    "jsx": "react-jsx"
  },
  "lib": [
    "dom"
  ],
  "include": [
    "helpers/**/*.ts",
    "spec/**/*.ts",
    "spec/**/*.tsx",
    "jest.setupAfterEnv.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}